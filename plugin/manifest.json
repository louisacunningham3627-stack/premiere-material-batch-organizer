{
  "manifestVersion": 5,
  "id": "com.hechao.premiere.material-batch-organizer",
  "name": "赫朝素材自动整理",
  "shortname": "素材自动整理",
  "version": "0.1.3",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["file"],
      "extensions": []
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "materialBatchOrganizer",
      "label": {
        "default": "赫朝素材自动整理"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 650
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/dark.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "all"],
      "species": ["pluginList"]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/light.svg",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["pluginList"]
    }
  ]
}
